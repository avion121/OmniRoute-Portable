# Binaries and Node modules
/bin/node.exe
/bin/node_modules/
/bin/*.log

# VS Code Portable
/vscode/
/data/vscode-user-data/
/data/vscode-extensions/

# Runtime, temporary, and sensitive data
/data/omniroute.log
/data/logs/
/data/call_logs/
/data/cache/
/data/cloudflared/
/data/db_backups/
/data/tailscale/
/data/supervisor/
/data/server/

# SQLite databases & journals (credentials, connection keys, history)
*.sqlite
*.sqlite-wal
*.sqlite-shm
/data/*.sqlite*
/home/**/storage.sqlite*

# Claude runtime sessions, caches, history, and pastes
/data/claude/*
!/data/claude/settings.json

# Configuration secrets and local scripts
/data/.env
*.env
*.env.local
push_repo.js

# User home profile directory
/home/

# Workspace user files (keep .vscode config)
/workspace/*
!/workspace/.vscode/

# OS specific files
Thumbs.db
Desktop.ini
.DS_Store
