# Binaries and Node modules
/bin/node.exe
/bin/node_modules/
/bin/*.log
/bin/*.exe
/bin/skills*
/bin/add-skill*

# Portable Python
/python/

# Portable Tools (Git, etc.)
/git/
/tools/

# Portable Hoppscotch
/hoppscotch/

# VS Code Portable
/vscode/
/data/vscode-user-data/
/data/vscode-extensions/

# Runtime, temporary, and sensitive data
/data/omniroute.log
/data/*.timestamp
/data/logs/
/data/call_logs/
/data/cache/
/data/temp/
/data/pip-cache/
/data/pycache/
/data/npm-cache/
/data/hoppscotch-data/
/data/config/
/data/cloudflared/
/data/db_backups/
/data/tailscale/
/data/supervisor/
/data/server/

# SQLite databases & journals (credentials, connection keys, history)
*.sqlite
*.sqlite-wal
*.sqlite-shm
/data/*.sqlite*
/home/**/storage.sqlite*

# Claude runtime sessions, caches, history, and pastes
/data/claude/*
!/data/claude/settings.json

# Configuration secrets and local scripts
/data/.env
*.env
*.env.local
push_repo.js

# Skills cache & lockfiles
/.agents/
/.claude/
/data/skills/
skills-lock.json

# User home profile directory
/home/

# Workspace user files (keep .vscode config & CLAUDE.md)
/workspace/*
!/workspace/.vscode/
!/workspace/CLAUDE.md

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# OS specific files
Thumbs.db
Desktop.ini
.DS_Store
